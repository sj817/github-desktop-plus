{
  "name": "github-desktop-plus",
  "version": "0.1.0",
  "type": "module",
  "description": "External enhancement tool for GitHub Desktop — Rust runtime + 0-path Electron hooks",
  "scripts": {
    "build:hooks": "node scripts/build-hooks.mjs",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all -- --check",
    "gdp:build": "pnpm run build:hooks && cargo build --workspace",
    "gdp:dev": "pnpm run build:hooks && cargo run -p gdp -- dev",
    "serve": "pnpm run build:hooks && cargo run -p gdp -- serve",
    "check": "pnpm run build:hooks && cargo check --workspace",
    "build": "pnpm run build:hooks && cargo build --workspace --release",
    "dev": "pnpm run gdp:dev",
    "self-check:desktop": "pnpm run build:hooks && tsx scripts/self-check-desktop.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2"
  }
}
